# Defaults to a local SQLite file if unset — fine for Milestone 1.
# When you're ready to move to Neon Postgres, set this to your Neon connection string, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@ep-xxxx.neon.tech/nfl_betting?sslmode=require
DATABASE_URL=sqlite:///data/processed/nfl_betting.db
